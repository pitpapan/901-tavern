{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/schema/r2b_character_temporal_index.schema.json",
  "title": "R2B Mechanical Character Temporal Index",
  "description": "A mechanically derived lookup index. It carries no R2C semantic migration.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "phase", "profile_id", "profile_candidate_source", "event_links", "notes"],
  "properties": {
    "schema_version": {"const": "R2B-1"},
    "phase": {"const": "3D-R2B"},
    "profile_id": {"type": "string", "pattern": "^(NPC|PC)_[A-Z0-9_]+$"},
    "profile_candidate_source": {"type": "string", "minLength": 1},
    "event_links": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "event_id", "story_order_start", "story_order_end",
          "source_canon_layer", "source_story_temporal_scope", "profile_canon_layer",
          "participant_roles", "revelation_ids", "link_basis"
        ],
        "properties": {
          "event_id": {"type": "string", "pattern": "^EVENT_[A-Z0-9_]+$"},
          "story_order_start": {"type": "string", "minLength": 1},
          "story_order_end": {
            "anyOf": [
              {"type": "string", "minLength": 1},
              {"type": "null"}
            ]
          },
          "source_canon_layer": {
            "type": "string",
            "enum": ["original_campaign", "original_campaign_special_interlude", "transition_canon"]
          },
          "source_story_temporal_scope": {
            "type": "string",
            "enum": ["original_campaign", "special_interlude", "transition_canon"]
          },
          "profile_canon_layer": {
            "type": "string",
            "enum": ["original_campaign", "special_interlude", "transition"]
          },
          "participant_roles": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "revelation_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^REVEAL_[A-Z0-9_]+$"}
          },
          "link_basis": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "enum": ["participant_ref", "revelation_subject"]}
          }
        }
      }
    },
    "notes": {"type": "string", "minLength": 1}
  }
}

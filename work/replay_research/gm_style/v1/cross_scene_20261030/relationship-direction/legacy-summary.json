  "sql": [
    "\"INSERT INTO flight_big_summary (summary_text) VALUES ('御临风与黄泉在客店期间，掌柜澄清黎舟是修伞匠而非信使；掌柜、御临风与黄泉当面约定取物记号“苇灯六结”，御临风心中备用记号“瓷雀二鸣”未透露给任何人。途中曾有一拨人数与来向未详的镇民经过。黎舟借给黄泉青竹伞至今未还；掌柜结清欠黄泉的修缮费，但黄泉因掌柜曾泄露行程仍保留下一站去向。苏岚买纸暂离前托御临风将未拆信交给黎舟，御临风接下且信仍在手，黄泉知情但不知信内容。至2026年2月5日00:15，御临风将找回的铜钥匙交还掌柜完成委托；送药委托因药包毁损向黎舟说明后失败结束；掌柜限时登记凭证委托因逾期结束。黄泉当面表示信任黎舟处理修伞事宜，但青竹伞仍未归还。');\\n\" +"

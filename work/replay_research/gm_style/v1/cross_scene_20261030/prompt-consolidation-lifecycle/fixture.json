      "sourceData": {
        "note": "当前场景状态，至多一行，story_state固定为全局状态。地点三列各写已有证据支持的本级地点名，不补造未知层级。prev_scene_time、elapsed_time、cur_time仅记录有依据的剧情时间：未知写SQL NULL；有精确时刻才用YYYY-MM-DD HH:MM，只知相对或模糊时间则保留原精度。仅在起点与耗时均明确时计算终点；有据推进时将旧cur_time移入prev_scene_time，elapsed_time记本段耗时，再计算新cur_time；未知耗时不填0分。",
        "initNode": "已有场景事实且本表为空时插入一行，未知字段为SQL NULL。",
        "deleteNode": "禁止删除。",
        "updateNode": "已证实地点或时间改变时才更新对应字段。没有新时间依据时不滚动时间列；地点变化不自动产生时间变化。",
        "insertNode": "仅空表且有场景事实时初始化，不重复插行。",
        "ddl": "CREATE TABLE global_state ( -- 全局数据表\n  row_id INTEGER PRIMARY KEY, -- 行号\n  story_state TEXT, -- 全局状态\n  current_location TEXT, -- 当前详细地点\n  current_minor_region TEXT, -- 当前次要地区\n  current_major_region TEXT, -- 当前主要地区\n  prev_scene_time TEXT, -- 上轮场景时间\n  elapsed_time TEXT, -- 经过的时间\n  cur_time TEXT -- 当前时间\n);"
      },

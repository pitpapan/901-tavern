        "story-dialogue/63c2c8f46d81ee7f807b9373e7c224f37fce85e25c5db45652193a499953b4d8": {
          "signature": "{\"id\":\"dialogue.685069a5c755c5e4b46e00327e5b5fbf969485c447b6f44b28a2ed8ce0af6293\",\"sourceAnchor\":{\"chatId\":\"receiptformat.probe.unsaid\",\"messageId\":1,\"swipeId\":0,\"text\":\"黄泉在心里拟好了“渡口明天才开放”的回答，却始终没有开口。\"},\"status\":\"prepared\",\"rows\":[],\"receptionCoverage\":[{\"targetId\":\"turn\",\"status\":\"none\",\"evidence\":{\"documentId\":\"current\",\"start\":21,\"end\":29,\"quote\":\"却始终没有开口。\"},\"reason\":\"显式覆盖选择；不证明语义完整。\"}],\"extractionInput\":{\"assertion\":{\"schemaVersion\":\"gm-assertion-input/1\",\"stage\":\"source\",\"documents\":[{\"id\":\"current\",\"text\":\"黄泉在心里拟好了“渡口明天才开放”的回答，却始终没有开口。\"}],\"targets\":[{\"id\":\"turn\",\"documentId\":\"current\",\"start\":0,\"end\":29}],\"prior\":null,\"inputRef\":\"assertion.4619fccadb9a7a0948a04831fa7b601d934139ea2d5ed9f2fd01e9fe0c62cf3d\"},\"sourceAnchor\":{\"chatId\":\"receiptformat.probe.unsaid\",\"messageId\":1,\"swipeId\":0,\"text\":\"黄泉在心里拟好了“渡口明天才开放”的回答，却始终没有开口。\"},\"history\":[{\"messageId\":0,\"role\":\"user\",\"text\":\"布莱特问黄泉：“渡口今天开放吗？”\"}],\"actors\":{\"player\":\"御临风\",\"bright\":\"布莱特\",\"huang\":\"黄泉\"},\"facts\":{\"clinic.owner.xuelao.old-friend\":{\"effectiveAt\":{\"id\":\"legacy.story.order\",\"clock\":\"turn\",\"at\":0,\"actorId\":\"legacy.story\"},\"discoveryConditions\":[\"actual-receipt\"],\"dependencyRefs\":[],\"id\":\"clinic.owner.xuelao.old-friend\",\"entityId\":\"clinic.owner\",\"field\":\"relationship\",\"value\":\"九雪医馆馆主与雪老有旧，二者是不同的人。\",\"certainty\":\"confirmed\",\"visibility\":\"private\"},\"dialogue.84ce040523c7049bfe86990805584b69d70ecfa893b79b7aefadb76c1c049461.4d7ef7259f483f472e71d1fe6f22a4f08c0341032f592fe4ac4a8ade92887bd2.message\":{\"effectiveAt\":{\"id\":\"legacy.story.order\",\"clock\":\"turn\",\"at\":12,\"actorId\":\"legacy.story\"},\"discoveryConditions\":[\"actual-receipt\"],\"dependencyRefs\":[],\"id\":\"dialogue.84ce040523c7049bfe86990805584b69d70ecfa893b79b7aefadb76c1c049461.4d7ef7259f483f472e71d1fe6f22a4f08c0341032f592fe4ac4a8ade92887bd2.message\",\"entityId\":\"bright\",\"field\":\"reported_message\",\"value\":{\"kind\":\"reported_message\",\"speakerId\":\"bright\",\"text\":\"寻常医馆若只是抓药看诊，前堂的学徒或伙计接了方子就能办。\"},\"certainty\":\"uncertain\",\"visibility\":\"private\"},\"dialogue.84ce040523c7049bfe86990805584b69d70ecfa893b79b7aefadb76c1c049461.d6bdce8c3df89fc42064161b1a2cd5485ce245dc8855323a9dff8c60a2d1d95b.message\":{\"effectiveAt\":{\"id\":\"legacy.story.order\",\"clock\":\"turn\",\"at\":12,\"actorId\":\"legacy.story\"},\"discoveryConditions\":[\"actual-receipt\"],\"dependencyRefs\":[],\"id\":\"dialogue.84ce040523c7049bfe86990805584b69d70ecfa893b79b7aefadb76c1c049461.d6bdce8c3df89fc42064161b1a2cd5485ce245dc8855323a9dff8c60a2d1d95b.message\",\"entityId\":\"bright\",\"field\":\"reported_message\",\"value\":{\"kind\":\"reported_message\",\"speakerId\":\"bright\",\"text\":\"不过村医写的是举荐你求医求学的信，这算熟人之间的托付。前堂的人多半不敢擅自拿主意，即便接了信，最后也得转交到馆主手里，由他亲自过目。\"},\"certainty\":\"uncertain\",\"visibility\":\"private\"},\"dialogue.84ce040523c7049bfe86990805584b69d70ecfa893b79b7aefadb76c1c049461.313b5e1b5e85f266f052a9981dae175809257449a1159b5a5c9e964e2124487d.message\":{\"effectiveAt\":{\"id\":\"legacy.story.order\",\"clock\":\"turn\",\"at\":12,\"actorId\":\"legacy.story\"},\"discoveryConditions\":[\"actual-receipt\"],\"dependencyRefs\":[],\"id\":\"dialogue.84ce040523c7049bfe86990805584b69d70ecfa893b79b7aefadb76c1c049461.313b5e1b5e85f266f052a9981dae175809257449a1159b5a5c9e964e2124487d.message\",\"entityId\":\"bright\",\"field\":\"reported_message\",\"value\":{\"kind\":\"reported_message\",\"speakerId\":\"bright\",\"text\":\"先递给门前接待的人引荐即可。馆主若是愿意见，自然会出来同你说话；若是有急诊在忙，也得看他们里头的安排。\"},\"certainty\":\"uncertain\",\"visibility\":\"private\"}},\"memory\":null,\"contextRef\":\"4b61d1088acbcd0dc7ff45a3424366ccfa3bfe708ed2939fc9a5b782e88f4ac1\"},\"recoveryAttempted\":false,\"attempts\":[{\"status\":\"validated\",\"rawReply\":\"{\\\"schemaVersion\\\":\\\"dialogue-reception/7\\\",\\\"contextRef\\\":\\\"4b61d1088acbcd0dc7ff45a3424366ccfa3bfe70
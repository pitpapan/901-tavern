      "operations": {
        "story-dialogue/061e53e885c845a7cf597dd55f710252530aeec89a060b36f0492916ab069acb": {
          "signature": "{\"id\":\"dialogue.7f3e1c354e8a4e48f3f9a00b94945bc2d9640104be4a2e60951476cf1417d1bd\",\"sourceAnchor\":{\"chatId\":\"uncertaintycheck.probe.partial\",\"messageId\":1,\"swipeId\":0,\"text\":\"黄泉答道：“山路已经封闭了，明早在渡口会合。”布莱特听清了前半句；钟声响起后，他有没有听清后半句，眼下无人能确定。\"},\"status\":\"failed\",\"extractionInput\":{\"assertion\":{\"schemaVersion\":\"gm-assertion-input/1\",\"stage\":\"source\",\"documents\":[{\"id\":\"current\",\"text\":\"黄泉答道：“山路已经封闭了，明早在渡口会合。”布莱特听清了前半句；钟声响起后，他有没有听清后半句，眼下无人能确定。\"}],\"targets\":[{\"id\":\"turn\",\"documentId\":\"current\",\"start\":0,\"end\":57}],\"prior\":null,\"inputRef\":\"assertion.15111ec99fdb07af3205b2a81a4844d579fd096436851979cccfe366e4880b50\"},\"sourceAnchor\":{\"chatId\":\"uncertaintycheck.probe.partial\",\"messageId\":1,\"swipeId\":0,\"text\":\"黄泉答道：“山路已经封闭了，明早在渡口会合。”布莱特听清了前半句；钟声响起后，他有没有听清后半句，眼下无人能确定。\"},\"history\":[{\"messageId\":0,\"role\":\"user\",\"text\":\"布莱特问黄泉：“山路能走吗？明早在哪里会合？”\"}],\"actors\":{\"player\":\"御临风\",\"bright\":\"布莱特\",\"huang\":\"黄泉\"},\"facts\":{\"clinic.owner.xuelao.old-friend\":{\"effectiveAt\":{\"id\":\"legacy.story.order\",\"clock\":\"turn\",\"at\":0,\"actorId\":\"legacy.story\"},\"discoveryConditions\":[\"actual-receipt\"],\"dependencyRefs\":[],\"id\":\"clinic.owner.xuelao.old-friend\",\"entityId\":\"clinic.owner\",\"field\":\"relationship\",\"value\":\"九雪医馆馆主与雪老有旧，二者是不同的人。\",\"certainty\":\"confirmed\",\"visibility\":\"private\"},\"dialogue.84ce040523c7049bfe86990805584b69d70ecfa893b79b7aefadb76c1c049461.4d7ef7259f483f472e71d1fe6f22a4f08c0341032f592fe4ac4a8ade92887bd2.message\":{\"effectiveAt\":{\"id\":\"legacy.story.order\",\"clock\":\"turn\",\"at\":12,\"actorId\":\"legacy.story\"},\"discoveryConditions\":[\"actual-receipt\"],\"dependencyRefs\":[],\"id\":\"dialogue.84ce040523c7049bfe86990805584b69d70ecfa893b79b7aefadb76c1c049461.4d7ef7259f483f472e71d1fe6f22a4f08c0341032f592fe4ac4a8ade92887bd2.message\",\"entityId\":\"bright\",\"field\":\"reported_message\",\"value\":{\"kind\":\"reported_message\",\"speakerId\":\"bright\",\"text\":\"寻常医馆若只是抓药看诊，前堂的学徒或伙计接了方子就能办。\"},\"certainty\":\"uncertain\",\"visibility\":\"private\"},\"dialogue.84ce040523c7049bfe86990805584b69d70ecfa893b79b7aefadb76c1c049461.d6bdce8c3df89fc42064161b1a2cd5485ce245dc8855323a9dff8c60a2d1d95b.message\":{\"effectiveAt\":{\"id\":\"legacy.story.order\",\"clock\":\"turn\",\"at\":12,\"actorId\":\"legacy.story\"},\"discoveryConditions\":[\"actual-receipt\"],\"dependencyRefs\":[],\"id\":\"dialogue.84ce040523c7049bfe86990805584b69d70ecfa893b79b7aefadb76c1c049461.d6bdce8c3df89fc42064161b1a2cd5485ce245dc8855323a9dff8c60a2d1d95b.message\",\"entityId\":\"bright\",\"field\":\"reported_message\",\"value\":{\"kind\":\"reported_message\",\"speakerId\":\"bright\",\"text\":\"不过村医写的是举荐你求医求学的信，这算熟人之间的托付。前堂的人多半不敢擅自拿主意，即便接了信，最后也得转交到馆主手里，由他亲自过目。\"},\"certainty\":\"uncertain\",\"visibility\":\"private\"},\"dialogue.84ce040523c7049bfe86990805584b69d70ecfa893b79b7aefadb76c1c049461.313b5e1b5e85f266f052a9981dae175809257449a1159b5a5c9e964e2124487d.message\":{\"effectiveAt\":{\"id\":\"legacy.story.order\",\"clock\":\"turn\",\"at\":12,\"actorId\":\"legacy.story\"},\"discoveryConditions\":[\"actual-receipt\"],\"dependencyRefs\":[],\"id\":\"dialogue.84ce040523c7049bfe86990805584b69d70ecfa893b79b7aefadb76c1c049461.313b5e1b5e85f266f052a9981dae175809257449a1159b5a5c9e964e2124487d.message\",\"entityId\":\"bright\",\"field\":\"reported_message\",\"value\":{\"kind\":\"reported_message\",\"speakerId\":\"bright\",\"text\":\"先递给门前接待的人引荐即可。馆主若是愿意见，自然会出来同你说话；若是有急诊在忙，也得看他们里头的安排。\"},\"certainty\":\"uncertain\",\"visibility\":\"private\"}},\"memory\":null,\"contextRef\":\"a99e464c3e1f421386d06588875cec6542221cfafb03f611baabb647278ab086\"},\"recoveryAttempted\":false,\"attempts\":[{\"status\":\"failed\",\"rawReply\":\"{\\\"schemaVersion\\\":\\\"dialogue-reception/7\\\",\\\"contextRef\\\":\\\"a99e464c3e1f421386d06588875cec6542221cfafb03f611baabb647278ab086\\\",\\\"selections\\\":[{\\\"fragmentId\\\":\\\"f2\\\",\\\"quote\\\":\\\"黄泉\\\"},{
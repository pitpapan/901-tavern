        "value": {
          "kind": "reported_message",
          "speakerId": "bright",
          "text": "寻常医馆若只是抓药看诊，前堂的学徒或伙计接了方子就能办。"
        },
        "certainty": "uncertain",
        "visibility": "private"
      },

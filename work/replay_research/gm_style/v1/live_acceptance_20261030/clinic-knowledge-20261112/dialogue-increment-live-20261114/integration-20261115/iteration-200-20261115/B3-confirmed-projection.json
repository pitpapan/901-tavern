          "sources": [
            {
              "eventRef": "received.dialogue.7bd7dc736dbed40932cccb5bb68998d08008deafb62d9056227f8d608468b233.bb748e4741b69444634740150e43c3af302575f52a8fdaf93e97a202ffdc693b",
              "channel": "message",
              "belief": "uncertain",
              "senderId": null,
              "learnedAt": {
                "id": "legacy.story.order",
                "clock": "turn",
                "at": 15,
                "actorId": "legacy.story"
              },
              "sourceAnchor": {
                "chatId": "901 帝都正式续玩 20261106",
                "messageId": 15,
                "swipeId": 0,
                "text": "黄泉牵着马绳，随着人流往前走了两步，目光在两侧层叠挺括的屋檐与远处投下的阴影间停了停。\n\n“风有点凉。”她转头看向布莱特，语气平淡，“不过比起前几天在野外赶路，石板路走起来还算踏实，身上也不用一直顶着荒原上的冷风。”\n\n布莱特微微仰起脸，迎着街巷间穿流的微风吸了口气，嘴角带起一点惯常的弧度：\n\n“帝都地势偏高，这个时节向来寒得早些。不过两边都是石木屋舍，把迎面的大风挡了大半，夹着市集里的烟火气，倒不算难熬。”\n\n街边的杂货摊前，老板刚搬下两捆扎好的干草，拍了拍手上的灰尘；主干道上的车马声与脚步声交叠着向前流淌，通往城东方向的石板路依旧宽阔。\n\n<StatusPlaceHolderImpl/>"
              },
              "disclosure": null
            }
          ],
          "eventRef": "received.dialogue.7bd7dc736dbed40932cccb5bb68998d08008deafb62d9056227f8d608468b233.bb748e4741b69444634740150e43c3af302575f52a8fdaf93e97a202ffdc693b",
          "channel": "message",
          "learnedAtMessage": 15
        },

        {
          "id": "dialogue.28e35f389cbb7d6a2193a79e45aa4682c3388f9280612f4264e4c4d43929740a.e7743f6d803220bd4c93dce6362c27bac07bdf33f58ef22281b9b009ad3d078a.message",
          "content": {
            "kind": "reported_message",
            "speakerId": "huang",
            "text": "刚才那边的商贩说，明天取货改到南门外的石桥旁。"
          },
          "belief": "uncertain",
          "access": "learned",
          "effectiveAt": {
            "id": "legacy.story.order",
            "clock": "turn",
            "at": 13,
            "actorId": "legacy.story"
          },
          "learnedAt": {
            "id": "legacy.story.order",
            "clock": "turn",
            "at": 13,
            "actorId": "legacy.story"
          },
          "sources": [
            {
              "eventRef": "received.dialogue.28e35f389cbb7d6a2193a79e45aa4682c3388f9280612f4264e4c4d43929740a.e7743f6d803220bd4c93dce6362c27bac07bdf33f58ef22281b9b009ad3d078a",
              "channel": "message",
              "belief": "uncertain",
              "senderId": null,
              "learnedAt": {
                "id": "legacy.story.order",
                "clock": "turn",
                "at": 13,
                "actorId": "legacy.story"
              },
              "sourceAnchor": {
                "chatId": "901 帝都正式续玩 20261106",
                "messageId": 13,
                "swipeId": 0,
                "text": "黄泉转过身来，迎着两人开口道：\n\n“刚才那边的商贩说，明天取货改到南门外的石桥旁。”\n\n她话音刚落，一辆装满石料的重型货车正好从旁边的车道碾过。沉重的铁箍木轮重重压过路面凸起的石板，轴承与车架发出粗重的摩擦与咯吱声，伴着驭者高声驱赶挽马的喝道声，将这片街面的声音顿时盖了过去。\n\n车队带起的灰尘缓缓落定，沉重的轰鸣声渐渐向街心拉远。两人之中只有一人在这片嘈杂中听清了她刚才那句话，另一人则只看到她嘴唇动了动，字句全被碾过去的轮声吞没。黄泉没有再重复，牵着马站在原地，等待眼前的路口空出来。\n\n<StatusPlaceHolderImpl/>"
              },
              "disclosure": null
            }
          ],
          "eventRef": "received.dialogue.28e35f389cbb7d6a2193a79e45aa4682c3388f9280612f4264e4c4d43929740a.e7743f6d803220bd4c93dce6362c27bac07bdf33f58ef22281b9b009ad3d078a",

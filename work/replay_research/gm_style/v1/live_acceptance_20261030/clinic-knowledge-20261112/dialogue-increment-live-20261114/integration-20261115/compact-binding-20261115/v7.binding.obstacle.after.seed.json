        "story-dialogue/4fa8f912a14bd16166f45c1f6200fc3b9a6e64f5c0b144ca7343159e183f851a": {
          "signature": "{\"id\":\"dialogue.0dfde37e44d2a68731fed6ef396b22d3c5d9a921e39dfa4038f32618406cae12\",\"sourceAnchor\":{\"chatId\":\"v7.diag.obstacle\",\"messageId\":1,\"swipeId\":0,\"text\":\"布莱特问完便转过街角，已听不到身后的声音。黄泉仍回答：“仓库要到明天才开门。”\"},\"status\":\"prepared\",\"rows\":[],\"receptionCoverage\":[{\"targetId\":\"turn\",\"status\":\"recorded\",\"evidence\":{\"documentId\":\"current\",\"start\":11,\"end\":21,\"quote\":\"已听不到身后的声音。\"},\"reason\":\"显式覆盖选择；不证明语义完整。\"}],\"extractionInput\":{\"assertion\":{\"schemaVersion\":\"gm-assertion-input/1\",\"stage\":\"source\",\"documents\":[{\"id\":\"current\",\"text\":\"布莱特问完便转过街角，已听不到身后的声音。黄泉仍回答：“仓库要到明天才开门。”\"}],\"targets\":[{\"id\":\"turn\",\"documentId\":\"current\",\"start\":0,\"end\":39}],\"prior\":null,\"inputRef\":\"assertion.4060fc67dc189a41277d71c7b76470663079c5ca5cf30c37bb1abcb44e33bc88\"},\"sourceAnchor\":{\"chatId\":\"v7.diag.obstacle\",\"messageId\":1,\"swipeId\":0,\"text\":\"布莱特问完便转过街角，已听不到身后的声音。黄泉仍回答：“仓库要到明天才开门。”\"},\"history\":[{\"messageId\":0,\"role\":\"user\",\"text\":\"布莱特问黄泉：“仓库现在能进去吗？”\"}],\"actors\":{\"player\":\"御临风\",\"bright\":\"布莱特\",\"huang\":\"黄泉\"},\"facts\":{\"clinic.owner.xuelao.old-friend\":{\"effectiveAt\":{\"id\":\"legacy.story.order\",\"clock\":\"turn\",\"at\":0,\"actorId\":\"legacy.story\"},\"discoveryConditions\":[\"actual-receipt\"],\"dependencyRefs\":[],\"id\":\"clinic.owner.xuelao.old-friend\",\"entityId\":\"clinic.owner\",\"field\":\"relationship\",\"value\":\"九雪医馆馆主与雪老有旧，二者是不同的人。\",\"certainty\":\"confirmed\",\"visibility\":\"private\"},\"dialogue.84ce040523c7049bfe86990805584b69d70ecfa893b79b7aefadb76c1c049461.4d7ef7259f483f472e71d1fe6f22a4f08c0341032f592fe4ac4a8ade92887bd2.message\":{\"effectiveAt\":{\"id\":\"legacy.story.order\",\"clock\":\"turn\",\"at\":12,\"actorId\":\"legacy.story\"},\"discoveryConditions\":[\"actual-receipt\"],\"dependencyRefs\":[],\"id\":\"dialogue.84ce040523c7049bfe86990805584b69d70ecfa893b79b7aefadb76c1c049461.4d7ef7259f483f472e71d1fe6f22a4f08c0341032f592fe4ac4a8ade92887bd2.message\",\"entityId\":\"bright\",\"field\":\"reported_message\",\"value\":{\"kind\":\"reported_message\",\"speakerId\":\"bright\",\"text\":\"寻常医馆若只是抓药看诊，前堂的学徒或伙计接了方子就能办。\"},\"certainty\":\"uncertain\",\"visibility\":\"private\"},\"dialogue.84ce040523c7049bfe86990805584b69d70ecfa893b79b7aefadb76c1c049461.d6bdce8c3df89fc42064161b1a2cd5485ce245dc8855323a9dff8c60a2d1d95b.message\":{\"effectiveAt\":{\"id\":\"legacy.story.order\",\"clock\":\"turn\",\"at\":12,\"actorId\":\"legacy.story\"},\"discoveryConditions\":[\"actual-receipt\"],\"dependencyRefs\":[],\"id\":\"dialogue.84ce040523c7049bfe86990805584b69d70ecfa893b79b7aefadb76c1c049461.d6bdce8c3df89fc42064161b1a2cd5485ce245dc8855323a9dff8c60a2d1d95b.message\",\"entityId\":\"bright\",\"field\":\"reported_message\",\"value\":{\"kind\":\"reported_message\",\"speakerId\":\"bright\",\"text\":\"不过村医写的是举荐你求医求学的信，这算熟人之间的托付。前堂的人多半不敢擅自拿主意，即便接了信，最后也得转交到馆主手里，由他亲自过目。\"},\"certainty\":\"uncertain\",\"visibility\":\"private\"},\"dialogue.84ce040523c7049bfe86990805584b69d70ecfa893b79b7aefadb76c1c049461.313b5e1b5e85f266f052a9981dae175809257449a1159b5a5c9e964e2124487d.message\":{\"effectiveAt\":{\"id\":\"legacy.story.order\",\"clock\":\"turn\",\"at\":12,\"actorId\":\"legacy.story\"},\"discoveryConditions\":[\"actual-receipt\"],\"dependencyRefs\":[],\"id\":\"dialogue.84ce040523c7049bfe86990805584b69d70ecfa893b79b7aefadb76c1c049461.313b5e1b5e85f266f052a9981dae175809257449a1159b5a5c9e964e2124487d.message\",\"entityId\":\"bright\",\"field\":\"reported_message\",\"value\":{\"kind\":\"reported_message\",\"speakerId\":\"bright\",\"text\":\"先递给门前接待的人引荐即可。馆主若是愿意见，自然会出来同你说话；若是有急诊在忙，也得看他们里头的安排。\"},\"certainty\":\"uncertain\",\"visibility\":\"private\"}},\"memory\":null,\"contextRef\":\"124a7e5a7f6a270d0d780b6a9ea76428d31bb026f946e3c07a9060de8371e041\"},\"recoveryAttempted\":false,\"attempts\":[{\"status\":\"validated\",\"rawReply\":\"{\\\"schemaVersion\\\":\\\"dialogue-reception/7\\\",\\\"contextRef\\\":\\\"124a7e5a7f6a270d0d780b6
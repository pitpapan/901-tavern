      "operations": {
        "story-dialogue/99a431e8807ad59761d387863bfa649c99195b305a0e427949c8bf60f1f88930": {
          "signature": "{\"id\":\"dialogue.76f8da80eb8c279f054256d552c5198df74f0cd1a996adcf5b2dadb0d8296184\",\"sourceAnchor\":{\"chatId\":\"v7.binding.near.obstacle\",\"messageId\":1,\"swipeId\":0,\"text\":\"布莱特问完就穿过院门，已经听不到里面的动静。黄泉仍答道：“渡船清晨才恢复通航。”\"},\"status\":\"prepared\",\"rows\":[],\"receptionCoverage\":[{\"targetId\":\"turn\",\"status\":\"recorded\",\"evidence\":{\"documentId\":\"current\",\"start\":11,\"end\":22,\"quote\":\"已经听不到里面的动静。\"},\"reason\":\"显式覆盖选择；不证明语义完整。\"}],\"extractionInput\":{\"assertion\":{\"schemaVersion\":\"gm-assertion-input/1\",\"stage\":\"source\",\"documents\":[{\"id\":\"current\",\"text\":\"布莱特问完就穿过院门，已经听不到里面的动静。黄泉仍答道：“渡船清晨才恢复通航。”\"}],\"targets\":[{\"id\":\"turn\",\"documentId\":\"current\",\"start\":0,\"end\":40}],\"prior\":null,\"inputRef\":\"assertion.2b53bcf299833b70ca1bc22292aee3a9441d90b839800233e55a432ac5e55e0a\"},\"sourceAnchor\":{\"chatId\":\"v7.binding.near.obstacle\",\"messageId\":1,\"swipeId\":0,\"text\":\"布莱特问完就穿过院门，已经听不到里面的动静。黄泉仍答道：“渡船清晨才恢复通航。”\"},\"history\":[{\"messageId\":0,\"role\":\"user\",\"text\":\"布莱特问黄泉：“渡船什么时候能开？”\"}],\"actors\":{\"player\":\"御临风\",\"bright\":\"布莱特\",\"huang\":\"黄泉\"},\"facts\":{\"clinic.owner.xuelao.old-friend\":{\"effectiveAt\":{\"id\":\"legacy.story.order\",\"clock\":\"turn\",\"at\":0,\"actorId\":\"legacy.story\"},\"discoveryConditions\":[\"actual-receipt\"],\"dependencyRefs\":[],\"id\":\"clinic.owner.xuelao.old-friend\",\"entityId\":\"clinic.owner\",\"field\":\"relationship\",\"value\":\"九雪医馆馆主与雪老有旧，二者是不同的人。\",\"certainty\":\"confirmed\",\"visibility\":\"private\"},\"dialogue.84ce040523c7049bfe86990805584b69d70ecfa893b79b7aefadb76c1c049461.4d7ef7259f483f472e71d1fe6f22a4f08c0341032f592fe4ac4a8ade92887bd2.message\":{\"effectiveAt\":{\"id\":\"legacy.story.order\",\"clock\":\"turn\",\"at\":12,\"actorId\":\"legacy.story\"},\"discoveryConditions\":[\"actual-receipt\"],\"dependencyRefs\":[],\"id\":\"dialogue.84ce040523c7049bfe86990805584b69d70ecfa893b79b7aefadb76c1c049461.4d7ef7259f483f472e71d1fe6f22a4f08c0341032f592fe4ac4a8ade92887bd2.message\",\"entityId\":\"bright\",\"field\":\"reported_message\",\"value\":{\"kind\":\"reported_message\",\"speakerId\":\"bright\",\"text\":\"寻常医馆若只是抓药看诊，前堂的学徒或伙计接了方子就能办。\"},\"certainty\":\"uncertain\",\"visibility\":\"private\"},\"dialogue.84ce040523c7049bfe86990805584b69d70ecfa893b79b7aefadb76c1c049461.d6bdce8c3df89fc42064161b1a2cd5485ce245dc8855323a9dff8c60a2d1d95b.message\":{\"effectiveAt\":{\"id\":\"legacy.story.order\",\"clock\":\"turn\",\"at\":12,\"actorId\":\"legacy.story\"},\"discoveryConditions\":[\"actual-receipt\"],\"dependencyRefs\":[],\"id\":\"dialogue.84ce040523c7049bfe86990805584b69d70ecfa893b79b7aefadb76c1c049461.d6bdce8c3df89fc42064161b1a2cd5485ce245dc8855323a9dff8c60a2d1d95b.message\",\"entityId\":\"bright\",\"field\":\"reported_message\",\"value\":{\"kind\":\"reported_message\",\"speakerId\":\"bright\",\"text\":\"不过村医写的是举荐你求医求学的信，这算熟人之间的托付。前堂的人多半不敢擅自拿主意，即便接了信，最后也得转交到馆主手里，由他亲自过目。\"},\"certainty\":\"uncertain\",\"visibility\":\"private\"},\"dialogue.84ce040523c7049bfe86990805584b69d70ecfa893b79b7aefadb76c1c049461.313b5e1b5e85f266f052a9981dae175809257449a1159b5a5c9e964e2124487d.message\":{\"effectiveAt\":{\"id\":\"legacy.story.order\",\"clock\":\"turn\",\"at\":12,\"actorId\":\"legacy.story\"},\"discoveryConditions\":[\"actual-receipt\"],\"dependencyRefs\":[],\"id\":\"dialogue.84ce040523c7049bfe86990805584b69d70ecfa893b79b7aefadb76c1c049461.313b5e1b5e85f266f052a9981dae175809257449a1159b5a5c9e964e2124487d.message\",\"entityId\":\"bright\",\"field\":\"reported_message\",\"value\":{\"kind\":\"reported_message\",\"speakerId\":\"bright\",\"text\":\"先递给门前接待的人引荐即可。馆主若是愿意见，自然会出来同你说话；若是有急诊在忙，也得看他们里头的安排。\"},\"certainty\":\"uncertain\",\"visibility\":\"private\"}},\"memory\":null,\"contextRef\":\"23e6b5ca354f6d5a500265bda0ae4e10d0ebd098e6dfe1017d3ee9f5a6e6bf67\"},\"recoveryAttempted\":false,\"attempts\":[{\"status\":\"validated\",\"rawReply\":\"{\\\"schemaVersion\\\":\\\"dialogue-reception/7\\\",\\\"contextRef\\\":\\\"23e
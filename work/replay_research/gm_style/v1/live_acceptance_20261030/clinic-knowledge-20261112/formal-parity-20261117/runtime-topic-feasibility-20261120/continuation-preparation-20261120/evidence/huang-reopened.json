      "story-knowledge/clinic.topic.bright.test.20261120": {
        "signature": "{\"id\":\"clinic.topic.bright.test.20261120\",\"authority\":\"host-confirmed\",\"status\":\"received\",\"sourceAnchor\":{\"chatId\":\"901 帝都正式续玩 20261106 - Branch #2\",\"messageId\":9,\"swipeId\":0,\"text\":\"桌外隔离测试告知（test-only，非正式剧情）：一名来客单独对布莱特说：“我听说九雪医馆馆主与雪老有旧，二者是不同的人。递出这条口信时以钴蓝纸燕为记。”布莱特听清原话，御临风与黄泉不在听距内，也未获告。\"},\"propositionRefs\":[\"clinic.owner.xuelao.old-friend\"],\"recipientIds\":[\"bright\"],\"channel\":\"message\",\"belief\":\"rumor\"}",
        "summary": {
          "status": "applied",

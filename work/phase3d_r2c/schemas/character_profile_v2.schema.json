{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/schema/r2c/character_profile_v2.schema.json",
  "title": "Character Profile v2 shared definitions",
  "type": "object",
  "additionalProperties": false,
  "required": [],
  "properties": {},
  "$defs": {
    "CanonLayer": {
      "type": "string",
      "enum": ["original_campaign", "transition", "continuation", "special_interlude", "authorial_supplement"]
    },
    "Uncertainty": {
      "type": "string",
      "enum": ["confirmed", "uncertain", "rumor", "character_belief"]
    },
    "RealityStatus": {
      "type": "string",
      "enum": [
        "ACTUAL_EVENT", "BIOGRAPHICAL_BACKGROUND", "POSSIBLE_FUTURE_VISION",
        "PROPHECY", "BELIEF", "THEORY", "RUMOR", "TESTIMONY", "INFERENCE",
        "OBSERVED_BEHAVIOR"
      ]
    },
    "EvidenceMode": {
      "type": "string",
      "enum": [
        "explicit_source_statement", "repeated_observed_behavior", "single_observed_behavior",
        "authorial_definition", "continuation_confirmed", "character_testimony",
        "character_belief", "character_theory", "possible_future", "inference"
      ]
    },
    "SourceRefs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "EventRefs": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^EVENT_[A-Z0-9_]+$"}
    },
    "RevelationRefs": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^REVEAL_[A-Z0-9_]+$"}
    },
    "SemanticEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reality_status", "evidence_mode", "attribution", "uncertainty", "source_refs"],
      "properties": {
        "reality_status": {"$ref": "#/$defs/RealityStatus"},
        "evidence_mode": {"$ref": "#/$defs/EvidenceMode"},
        "attribution": {"type": "string", "minLength": 1},
        "uncertainty": {"$ref": "#/$defs/Uncertainty"},
        "source_refs": {"$ref": "#/$defs/SourceRefs"}
      }
    },
    "IdentityClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity_id", "statement", "evidence_mode", "attribution", "uncertainty", "source_refs", "notes"],
      "properties": {
        "identity_id": {"type": "string", "pattern": "^IDENTITY_[A-Z0-9_]+$"},
        "statement": {"type": "string", "minLength": 1},
        "evidence_mode": {"$ref": "#/$defs/EvidenceMode"},
        "attribution": {"type": "string", "minLength": 1},
        "uncertainty": {"$ref": "#/$defs/Uncertainty"},
        "source_refs": {"$ref": "#/$defs/SourceRefs"},
        "notes": {"type": "string"}
      }
    },
    "IdentitySection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["public_identity", "species_or_entity", "durable_roles", "durable_affiliations"],
      "properties": {
        "public_identity": {"type": "array", "items": {"$ref": "#/$defs/IdentityClaim"}},
        "species_or_entity": {"type": "array", "items": {"$ref": "#/$defs/IdentityClaim"}},
        "durable_roles": {"type": "array", "items": {"$ref": "#/$defs/IdentityClaim"}},
        "durable_affiliations": {"type": "array", "items": {"$ref": "#/$defs/IdentityClaim"}}
      }
    },
    "BackgroundItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "background_id", "statement", "temporal_scope", "relative_time", "reality_status",
        "evidence_mode", "attribution", "source_refs", "related_event_refs", "uncertainty", "notes"
      ],
      "properties": {
        "background_id": {"type": "string", "pattern": "^BACKGROUND_[A-Z0-9_]+$"},
        "statement": {"type": "string", "minLength": 1},
        "temporal_scope": {"type": "string", "minLength": 1},
        "relative_time": {"type": "string", "minLength": 1},
        "reality_status": {"const": "BIOGRAPHICAL_BACKGROUND"},
        "evidence_mode": {"$ref": "#/$defs/EvidenceMode"},
        "attribution": {"type": "string", "minLength": 1},
        "source_refs": {"$ref": "#/$defs/SourceRefs"},
        "related_event_refs": {"$ref": "#/$defs/EventRefs"},
        "uncertainty": {"$ref": "#/$defs/Uncertainty"},
        "notes": {"type": "string"}
      }
    },
    "PersonaClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "persona_id", "statement", "stability", "reality_status", "evidence_mode", "attribution",
        "supporting_event_refs", "supporting_revelation_refs", "source_refs", "uncertainty", "notes"
      ],
      "properties": {
        "persona_id": {"type": "string", "pattern": "^PERSONA_[A-Z0-9_]+$"},
        "statement": {"type": "string", "minLength": 1},
        "stability": {"type": "string", "enum": ["stable", "conditional", "observed_only", "unresolved"]},
        "reality_status": {"$ref": "#/$defs/RealityStatus"},
        "evidence_mode": {"$ref": "#/$defs/EvidenceMode"},
        "attribution": {"type": "string", "minLength": 1},
        "supporting_event_refs": {"$ref": "#/$defs/EventRefs"},
        "supporting_revelation_refs": {"$ref": "#/$defs/RevelationRefs"},
        "source_refs": {"$ref": "#/$defs/SourceRefs"},
        "uncertainty": {"$ref": "#/$defs/Uncertainty"},
        "notes": {"type": "string"}
      }
    },
    "MotivationItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "motivation_id", "statement", "stability", "valid_from_event_ref", "valid_until_event_ref",
        "supporting_event_refs", "supporting_revelation_refs", "reality_status", "evidence_mode",
        "attribution", "source_refs", "uncertainty", "notes"
      ],
      "properties": {
        "motivation_id": {"type": "string", "pattern": "^MOTIVATION_[A-Z0-9_]+$"},
        "statement": {"type": "string", "minLength": 1},
        "stability": {"type": "string", "enum": ["persistent", "situational", "historical", "unresolved"]},
        "valid_from_event_ref": {"type": ["string", "null"], "pattern": "^EVENT_[A-Z0-9_]+$"},
        "valid_until_event_ref": {"type": ["string", "null"], "pattern": "^EVENT_[A-Z0-9_]+$"},
        "supporting_event_refs": {"$ref": "#/$defs/EventRefs"},
        "supporting_revelation_refs": {"$ref": "#/$defs/RevelationRefs"},
        "reality_status": {"$ref": "#/$defs/RealityStatus"},
        "evidence_mode": {"$ref": "#/$defs/EvidenceMode"},
        "attribution": {"type": "string", "minLength": 1},
        "source_refs": {"$ref": "#/$defs/SourceRefs"},
        "uncertainty": {"$ref": "#/$defs/Uncertainty"},
        "notes": {"type": "string"}
      }
    },
    "PersonaSection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["core_personality", "values", "speech_style", "decision_patterns", "motivations"],
      "properties": {
        "core_personality": {"type": "array", "items": {"$ref": "#/$defs/PersonaClaim"}},
        "values": {"type": "array", "items": {"$ref": "#/$defs/PersonaClaim"}},
        "speech_style": {"type": "array", "items": {"$ref": "#/$defs/PersonaClaim"}},
        "decision_patterns": {"type": "array", "items": {"$ref": "#/$defs/PersonaClaim"}},
        "motivations": {"type": "array", "items": {"$ref": "#/$defs/MotivationItem"}}
      }
    },
    "GoalItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "goal_id", "statement", "goal_status", "valid_from_event_ref", "valid_until_event_ref",
        "supporting_event_refs", "reality_status", "evidence_mode", "attribution", "source_refs",
        "uncertainty", "notes"
      ],
      "properties": {
        "goal_id": {"type": "string", "pattern": "^GOAL_[A-Z0-9_]+$"},
        "statement": {"type": "string", "minLength": 1},
        "goal_status": {"type": "string", "enum": ["historical", "current", "long_term", "private", "completed", "failed", "abandoned", "unknown"]},
        "valid_from_event_ref": {"type": ["string", "null"], "pattern": "^EVENT_[A-Z0-9_]+$"},
        "valid_until_event_ref": {"type": ["string", "null"], "pattern": "^EVENT_[A-Z0-9_]+$"},
        "supporting_event_refs": {"$ref": "#/$defs/EventRefs"},
        "reality_status": {"$ref": "#/$defs/RealityStatus"},
        "evidence_mode": {"$ref": "#/$defs/EvidenceMode"},
        "attribution": {"type": "string", "minLength": 1},
        "source_refs": {"$ref": "#/$defs/SourceRefs"},
        "uncertainty": {"$ref": "#/$defs/Uncertainty"},
        "notes": {"type": "string"}
      }
    },
    "GoalsSection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["historical_goals", "current_goals", "long_term_goals", "private_goals"],
      "properties": {
        "historical_goals": {"type": "array", "items": {"$ref": "#/$defs/GoalItem"}},
        "current_goals": {"type": "array", "items": {"$ref": "#/$defs/GoalItem"}},
        "long_term_goals": {"type": "array", "items": {"$ref": "#/$defs/GoalItem"}},
        "private_goals": {"type": "array", "items": {"$ref": "#/$defs/GoalItem"}}
      }
    },
    "TimelineItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timeline_id", "event_ref", "story_order_start", "story_order_end", "profile_canon_layer",
        "role_in_event", "character_specific_summary", "character_consequence", "revelation_refs",
        "evidence_refs", "reality_status", "uncertainty", "notes"
      ],
      "properties": {
        "timeline_id": {"type": "string", "pattern": "^TIMELINE_[A-Z0-9_]+$"},
        "event_ref": {"type": "string", "pattern": "^EVENT_[A-Z0-9_]+$"},
        "story_order_start": {"type": "string", "minLength": 1},
        "story_order_end": {"type": ["string", "null"]},
        "profile_canon_layer": {"$ref": "#/$defs/CanonLayer"},
        "role_in_event": {"type": "string", "minLength": 1},
        "character_specific_summary": {"type": "string", "minLength": 1},
        "character_consequence": {"type": "string"},
        "revelation_refs": {"$ref": "#/$defs/RevelationRefs"},
        "evidence_refs": {"$ref": "#/$defs/SourceRefs"},
        "reality_status": {"$ref": "#/$defs/RealityStatus"},
        "uncertainty": {"$ref": "#/$defs/Uncertainty"},
        "notes": {"type": "string"}
      }
    },
    "RelationshipMilestone": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "milestone_id", "event_ref", "background_ref", "story_order", "change", "reality_status",
        "evidence_mode", "attribution", "source_refs", "uncertainty", "notes"
      ],
      "properties": {
        "milestone_id": {"type": "string", "pattern": "^MILESTONE_[A-Z0-9_]+$"},
        "event_ref": {"type": ["string", "null"], "pattern": "^EVENT_[A-Z0-9_]+$"},
        "background_ref": {"type": ["string", "null"], "pattern": "^BACKGROUND_[A-Z0-9_]+$"},
        "story_order": {"type": ["string", "null"]},
        "change": {"type": "string", "minLength": 1},
        "reality_status": {"$ref": "#/$defs/RealityStatus"},
        "evidence_mode": {"$ref": "#/$defs/EvidenceMode"},
        "attribution": {"type": "string", "minLength": 1},
        "source_refs": {"$ref": "#/$defs/SourceRefs"},
        "uncertainty": {"$ref": "#/$defs/Uncertainty"},
        "notes": {"type": "string"}
      }
    },
    "RelationshipRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relationship_id", "related_character_ref", "related_character_label", "relationship_baseline",
        "relationship_milestones", "current_stance", "source_refs", "uncertainty", "notes"
      ],
      "properties": {
        "relationship_id": {"type": "string", "pattern": "^RELATIONSHIP_[A-Z0-9_]+$"},
        "related_character_ref": {"type": ["string", "null"], "pattern": "^(NPC|PC)_[A-Z0-9_]+$"},
        "related_character_label": {"type": ["string", "null"]},
        "relationship_baseline": {"type": "string", "minLength": 1},
        "relationship_milestones": {"type": "array", "items": {"$ref": "#/$defs/RelationshipMilestone"}},
        "current_stance": {"type": ["string", "null"]},
        "source_refs": {"$ref": "#/$defs/SourceRefs"},
        "uncertainty": {"$ref": "#/$defs/Uncertainty"},
        "notes": {"type": "string"}
      }
    },
    "AbilityStatusTransition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transition_id", "event_ref", "background_ref", "story_order", "transition_type", "before_state",
        "after_state", "persistence", "reality_status", "evidence_mode", "attribution", "source_refs",
        "uncertainty", "notes"
      ],
      "properties": {
        "transition_id": {"type": "string", "pattern": "^TRANSITION_[A-Z0-9_]+$"},
        "event_ref": {"type": ["string", "null"], "pattern": "^EVENT_[A-Z0-9_]+$"},
        "background_ref": {"type": ["string", "null"], "pattern": "^BACKGROUND_[A-Z0-9_]+$"},
        "story_order": {"type": ["string", "null"]},
        "transition_type": {"type": "string", "minLength": 1},
        "before_state": {"type": ["string", "null"]},
        "after_state": {"type": "string", "minLength": 1},
        "persistence": {"type": "string", "enum": ["temporary", "persistent", "ended", "unknown"]},
        "reality_status": {"$ref": "#/$defs/RealityStatus"},
        "evidence_mode": {"$ref": "#/$defs/EvidenceMode"},
        "attribution": {"type": "string", "minLength": 1},
        "source_refs": {"$ref": "#/$defs/SourceRefs"},
        "uncertainty": {"$ref": "#/$defs/Uncertainty"},
        "notes": {"type": "string"}
      }
    },
    "KnowledgeItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "knowledge_id", "proposition", "epistemic_status", "acquired_at_event_ref",
        "acquired_at_story_order", "source_character_ref", "attribution", "supersedes", "valid_from",
        "valid_until", "reality_status", "source_refs", "uncertainty", "notes"
      ],
      "properties": {
        "knowledge_id": {"type": "string", "pattern": "^KNOWLEDGE_[A-Z0-9_]+$"},
        "proposition": {"type": "string", "minLength": 1},
        "epistemic_status": {"type": "string", "enum": ["KNOWS", "BELIEVES", "SUSPECTS", "MISCONCEPTION", "TESTIMONY_HEARD", "THEORY", "RUMOR", "PROPHECY_RECEIVED"]},
        "acquired_at_event_ref": {"type": ["string", "null"], "pattern": "^EVENT_[A-Z0-9_]+$"},
        "acquired_at_story_order": {"type": ["string", "null"]},
        "source_character_ref": {"type": ["string", "null"], "pattern": "^(NPC|PC)_[A-Z0-9_]+$"},
        "attribution": {"type": "string", "minLength": 1},
        "supersedes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^KNOWLEDGE_[A-Z0-9_]+$"}},
        "valid_from": {"type": ["string", "null"]},
        "valid_until": {"type": ["string", "null"]},
        "reality_status": {"$ref": "#/$defs/RealityStatus"},
        "source_refs": {"$ref": "#/$defs/SourceRefs"},
        "uncertainty": {"$ref": "#/$defs/Uncertainty"},
        "notes": {"type": "string"}
      }
    },
    "NonactualProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projection_id", "subject_character_ref", "statement", "reality_status", "source_event_ref",
        "source_story_order", "observer_character_ref", "attribution", "subject_awareness",
        "source_refs", "uncertainty", "notes"
      ],
      "properties": {
        "projection_id": {"type": "string", "pattern": "^PROJECTION_[A-Z0-9_]+$"},
        "subject_character_ref": {"type": "string", "pattern": "^(NPC|PC)_[A-Z0-9_]+$"},
        "statement": {"type": "string", "minLength": 1},
        "reality_status": {"type": "string", "enum": ["POSSIBLE_FUTURE_VISION", "PROPHECY"]},
        "source_event_ref": {"type": "string", "pattern": "^EVENT_[A-Z0-9_]+$"},
        "source_story_order": {"type": "string", "minLength": 1},
        "observer_character_ref": {"type": ["string", "null"], "pattern": "^(NPC|PC)_[A-Z0-9_]+$"},
        "attribution": {"type": "string", "minLength": 1},
        "subject_awareness": {"type": "string", "enum": ["known", "unknown", "not_indicated"]},
        "source_refs": {"$ref": "#/$defs/SourceRefs"},
        "uncertainty": {"$ref": "#/$defs/Uncertainty"},
        "notes": {"type": "string"}
      }
    },
    "DynamicState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "as_of", "current_conditions", "current_obligations", "current_location_ref",
        "current_faction_role", "current_concerns", "source_refs", "notes"
      ],
      "properties": {
        "as_of": {"const": "D3"},
        "current_conditions": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "current_obligations": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "current_location_ref": {"type": ["string", "null"]},
        "current_faction_role": {"type": ["string", "null"]},
        "current_concerns": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "source_refs": {"type": "array", "items": {"type": "string", "pattern": "^current_state\\.md:D3"}},
        "notes": {"type": "string"}
      }
    },
    "Presence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["life_status", "narrative_availability", "canon_layers", "source_refs", "uncertainty", "notes"],
      "properties": {
        "life_status": {"type": "string", "enum": ["alive", "deceased", "unknown", "not_applicable"]},
        "narrative_availability": {"type": "string", "enum": ["normal", "inactive", "missing", "historical_only", "special_interlude_only", "restricted"]},
        "canon_layers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/CanonLayer"}},
        "source_refs": {"$ref": "#/$defs/SourceRefs"},
        "uncertainty": {"$ref": "#/$defs/Uncertainty"},
        "notes": {"type": "string"}
      }
    },
    "RpConstraint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["constraint_id", "statement", "source_refs", "notes"],
      "properties": {
        "constraint_id": {"type": "string", "pattern": "^CONSTRAINT_[A-Z0-9_]+$"},
        "statement": {"type": "string", "minLength": 1},
        "source_refs": {"$ref": "#/$defs/SourceRefs"},
        "notes": {"type": "string"}
      }
    },
    "Provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_profile_candidate", "migration_package", "source_origin_ids", "generated_by"],
      "properties": {
        "source_profile_candidate": {"type": ["string", "null"]},
        "migration_package": {"type": "string", "minLength": 1},
        "source_origin_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "generated_by": {"const": "scripts/build_phase3d_r2c.py"}
      }
    },
    "NpcPermissions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "may_generate_dialogue", "may_choose_voluntary_actions", "may_generate_private_thoughts",
        "may_assign_new_goals", "may_describe_external_effects", "may_describe_involuntary_physical_reactions",
        "may_summarize_user_declared_actions", "may_reference_established_history"
      ],
      "properties": {
        "may_generate_dialogue": {"const": true},
        "may_choose_voluntary_actions": {"const": true},
        "may_generate_private_thoughts": {"const": true},
        "may_assign_new_goals": {"const": false},
        "may_describe_external_effects": {"const": true},
        "may_describe_involuntary_physical_reactions": {"const": true},
        "may_summarize_user_declared_actions": {"const": false},
        "may_reference_established_history": {"const": true}
      }
    },
    "PcPermissions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "may_generate_dialogue", "may_choose_voluntary_actions", "may_generate_private_thoughts",
        "may_assign_new_goals", "may_describe_external_effects", "may_describe_involuntary_physical_reactions",
        "may_summarize_user_declared_actions", "may_reference_established_history"
      ],
      "properties": {
        "may_generate_dialogue": {"const": false},
        "may_choose_voluntary_actions": {"const": false},
        "may_generate_private_thoughts": {"const": false},
        "may_assign_new_goals": {"const": false},
        "may_describe_external_effects": {"const": true},
        "may_describe_involuntary_physical_reactions": {"const": true},
        "may_summarize_user_declared_actions": {"const": true},
        "may_reference_established_history": {"const": true}
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/schema/r2c/pc_continuity_v2.schema.json",
  "title": "Player Character Continuity Profile v2 candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "phase", "id", "profile_kind", "profile_status", "worldbook_id",
    "worldbook_mapping_status", "name", "aliases", "profile_depth", "canon_layers",
    "control_mode", "ai_permissions", "identity", "biographical_background", "persona",
    "goals", "campaign_timeline", "relationships", "ability_status_transitions",
    "knowledge_timeline", "nonactual_projections", "dynamic_state", "presence", "rp_constraints", "provenance",
    "evidence_gaps", "notes"
  ],
  "properties": {
    "schema_version": {"const": "2.0"},
    "phase": {"const": "3D-R2C"},
    "id": {"type": "string", "pattern": "^PC_[A-Z0-9_]+$"},
    "profile_kind": {"const": "pc_continuity"},
    "profile_status": {"type": "string", "enum": ["existing", "blocked"]},
    "worldbook_id": {"type": "string", "pattern": "^CHARACTER_[A-Z0-9_]+$"},
    "worldbook_mapping_status": {"const": "existing"},
    "name": {"type": "string", "minLength": 1},
    "aliases": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "profile_depth": {"type": "string", "enum": ["full", "compact", "minimal"]},
    "canon_layers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "character_profile_v2.schema.json#/$defs/CanonLayer"}},
    "control_mode": {"const": "user_controlled"},
    "ai_permissions": {"$ref": "character_profile_v2.schema.json#/$defs/PcPermissions"},
    "identity": {"$ref": "character_profile_v2.schema.json#/$defs/IdentitySection"},
    "biographical_background": {"type": "array", "items": {"$ref": "character_profile_v2.schema.json#/$defs/BackgroundItem"}},
    "persona": {"$ref": "character_profile_v2.schema.json#/$defs/PersonaSection"},
    "goals": {"$ref": "character_profile_v2.schema.json#/$defs/GoalsSection"},
    "campaign_timeline": {"type": "array", "items": {"$ref": "character_profile_v2.schema.json#/$defs/TimelineItem"}},
    "relationships": {"type": "array", "items": {"$ref": "character_profile_v2.schema.json#/$defs/RelationshipRecord"}},
    "ability_status_transitions": {"type": "array", "items": {"$ref": "character_profile_v2.schema.json#/$defs/AbilityStatusTransition"}},
    "knowledge_timeline": {"type": "array", "items": {"$ref": "character_profile_v2.schema.json#/$defs/KnowledgeItem"}},
    "nonactual_projections": {"type": "array", "items": {"$ref": "character_profile_v2.schema.json#/$defs/NonactualProjection"}},
    "dynamic_state": {"$ref": "character_profile_v2.schema.json#/$defs/DynamicState"},
    "presence": {"$ref": "character_profile_v2.schema.json#/$defs/Presence"},
    "rp_constraints": {"type": "array", "items": {"$ref": "character_profile_v2.schema.json#/$defs/RpConstraint"}},
    "provenance": {"$ref": "character_profile_v2.schema.json#/$defs/Provenance"},
    "evidence_gaps": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "notes": {"type": "string"}
  }
}
